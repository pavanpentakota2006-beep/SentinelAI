# Copy to .env and replace every CHANGE_ME value. Never commit .env.
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Backend
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/sentinelx
DB_USER=sentinelx
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
JWT_SECRET=CHANGE_ME_LONG_RANDOM_BASE64
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Optional external AI (platform works without it)
LLM_API_KEY=
ANALYTICS_SERVICE_URL=
